APP_NAME=BuilderX
APP_ENV=production
APP_DEBUG=false
APP_URL=https://client-domain.example/rbmsv4

DB_HOST=localhost
DB_DATABASE=builderx
DB_USERNAME=builderx_user
DB_PASSWORD=

SESSION_NAME=builderx_session
BUILDERX_SHOW_RESET_LINK=0
BX_ADMIN_DEFAULT_PASSWORD=<set-locally-never-commit>

AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Firebase Messenger production sync.
# Copy this file to .env on each server.
# Store the real service account JSON outside the web root and outside git.
# Example: /var/www/rbmsv4-private/firebase/rbmsv4-vrp-service-account.json
FIREBASE_PROJECT_ID=rbmsv4-vrp
FIREBASE_MESSENGER_SERVER_SYNC_ENABLED=1
FIREBASE_SERVICE_ACCOUNT_PATH=/secure/path/outside/webroot/rbmsv4-vrp-service-account.json
GOOGLE_APPLICATION_CREDENTIALS=/secure/path/outside/webroot/rbmsv4-vrp-service-account.json
FIREBASE_MESSENGER_COLLECTION=project_messenger_chat
FIREBASE_MESSENGER_ATTACHMENT_COLLECTION=project_messenger_chat_attachment
FIREBASE_MESSENGER_QUEUE_POLL_MS=2000
FIREBASE_MESSENGER_QUEUE_BATCH_SIZE=25
FIREBASE_MESSENGER_QUEUE_CLAIM_TIMEOUT_MINUTES=10
FIREBASE_QUEUE_MYSQL_CONNECTIONS=4

# Keep browser Firestore writes disabled until Firebase custom-token login is implemented.
FIREBASE_CLIENT_STREAM_ENABLED=0
FIREBASE_CLIENT_WRITE_ENABLED=0
FIREBASE_WEB_API_KEY=
FIREBASE_WEB_AUTH_DOMAIN=
FIREBASE_WEB_PROJECT_ID=rbmsv4-vrp
FIREBASE_WEB_STORAGE_BUCKET=
FIREBASE_WEB_MESSAGING_SENDER_ID=
FIREBASE_WEB_APP_ID=
FIREBASE_WEB_MEASUREMENT_ID=
## Inbound Firebase-to-MySQL read projection. Keep this dedicated least-privilege
## account separate from any legacy outbound Messenger credentials.
FIREBASE_MYSQL_SYNC_DB_HOST=localhost
FIREBASE_MYSQL_SYNC_DB_PORT=3306
FIREBASE_MYSQL_SYNC_DB_USER=rbms_firebase_sync
FIREBASE_MYSQL_SYNC_DB_PASSWORD=change-me-outside-source-control
FIREBASE_MYSQL_SYNC_DB_NAME=rbmsv4
FIREBASE_MYSQL_SYNC_SCAN_INTERVAL_MS=30000
FIREBASE_MYSQL_SYNC_WORK_POLL_MS=500
FIREBASE_MYSQL_SYNC_SCAN_PAGE_SIZE=100
FIREBASE_MYSQL_SYNC_WORKER_CONCURRENCY=4
FIREBASE_MYSQL_SYNC_LEASE_SECONDS=90
FIREBASE_MYSQL_SYNC_MAX_ATTEMPTS=12
FIREBASE_MYSQL_SYNC_BACKUP_TIMEZONE=Asia/Manila
FIREBASE_MYSQL_SYNC_MAX_DOCUMENT_BYTES=1048576
FIREBASE_MYSQL_SYNC_MAX_FIELDS_PER_COLLECTION=160
FIREBASE_MYSQL_SYNC_MAX_NEW_FIELDS_PER_SCAN=12
FIREBASE_MYSQL_SYNC_BACKUP_MAX_TABLE_BYTES=1073741824
FIREBASE_MYSQL_SYNC_ADVISORY_LOCK_SECONDS=30
