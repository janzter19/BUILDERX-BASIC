[Unit]
Description=BuilderX www-data File Service connection
After=local-fs.target

[Service]
Type=simple
User=www-data
Group=builderx
UMask=0007
WorkingDirectory=%I
Environment=BUILDERX_FILE_ROOT=%I
ExecStart=/usr/bin/php %I/bin/builderx-file-service.php
StandardInput=socket
StandardOutput=socket
StandardError=journal
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=%I
