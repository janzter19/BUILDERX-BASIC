[Unit]
Description=RBMSv4 combined Firebase sync service
After=network-online.target mysql.service
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/var/www/html/rbmsv4
EnvironmentFile=/var/www/html/rbmsv4/.env
ExecStart=/usr/local/bin/node /var/www/html/rbmsv4/scripts/firebase-sync.mjs
Restart=always
RestartSec=5
User=www-data
Group=www-data
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/var/www/html/rbmsv4/storage

[Install]
WantedBy=multi-user.target
